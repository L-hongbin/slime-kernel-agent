- Obtain the current stream with `TVMFFIEnvGetStream`.
- Pass raw pointers, metadata, scalars, and the opaque stream to C ABI launchers.
- Keep bindings thin and do not perform computation through PyTorch, ATen, or TVM operators.
- Prefer outputs/workspaces allocated in `MODEL_NEW`.
- Export every Python-callable wrapper with `TVM_FFI_DLL_EXPORT_TYPED_FUNC(exported_name, function_name);`.
- Exported names must exactly match the functions called by `MODEL_NEW`.
- Keep CUDA runtime headers and `cudaStream_t` out of the host binding source; use `void*` across the binding boundary.

Example binding shape:

```cpp
#include <tvm/ffi/tvm_ffi.h>
#include <tvm/ffi/extra/c_env_api.h>

extern "C" void example_launcher(
    float* output,
    const float* input,
    int64_t n,
    void* stream_handle);

void example_forward(
    tvm::ffi::Tensor input,
    tvm::ffi::Tensor output) {
    TVM_FFI_ICHECK(input.device().device_type == kDLCUDA)
        << "input must be CUDA";
    TVM_FFI_ICHECK(output.device().device_type == kDLCUDA)
        << "output must be CUDA";
    TVM_FFI_ICHECK(input.ndim() == 1)
        << "input must be 1D";
    TVM_FFI_ICHECK(output.ndim() == 1)
        << "output must be 1D";
    TVM_FFI_ICHECK(input.shape()[0] == output.shape()[0])
        << "shape mismatch";

    void* stream_handle = TVMFFIEnvGetStream(
        input.device().device_type,
        input.device().device_id);

    example_launcher(
        static_cast<float*>(output.data_ptr()),
        static_cast<const float*>(input.data_ptr()),
        input.shape()[0],
        stream_handle);
}

TVM_FFI_DLL_EXPORT_TYPED_FUNC(
    example_forward,
    example_forward);
```

