__global__ void my_kernel(const float* input, float* output, int64_t n) {
    int64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
    int64_t stride = blockDim.x * gridDim.x;
    for (int64_t i = idx; i < n; i += stride) {
        output[i] = input[i];
    }
}

extern "C" void my_kernel_launcher(float* output, const float* input, int64_t n, void* stream_handle) {
    cudaStream_t stream = static_cast<cudaStream_t>(stream_handle);
    int threads = 256;
    int blocks = static_cast<int>((n + threads - 1) / threads);
    my_kernel<<<blocks, threads, 0, stream>>>(input, output, n);
}
```

