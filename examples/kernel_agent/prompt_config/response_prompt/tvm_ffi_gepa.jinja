#include <tvm/ffi/tvm_ffi.h>
#include <tvm/ffi/extra/c_env_api.h>

extern "C" void my_kernel_launcher(float* out, const float* in, int64_t n, void* stream_handle);

void my_kernel_forward(tvm::ffi::Tensor input, tvm::ffi::Tensor output) {
    TVM_FFI_ICHECK(input.device().device_type == kDLCUDA) << "input must be CUDA";
    TVM_FFI_ICHECK(output.device().device_type == kDLCUDA) << "output must be CUDA";
    void* stream_handle = TVMFFIEnvGetStream(input.device().device_type, input.device().device_id);
    my_kernel_launcher(
        static_cast<float*>(output.data_ptr()),
        static_cast<const float*>(input.data_ptr()),
        input.shape()[0],
        stream_handle);
}

TVM_FFI_DLL_EXPORT_TYPED_FUNC(my_kernel_forward, my_kernel_forward);
```

