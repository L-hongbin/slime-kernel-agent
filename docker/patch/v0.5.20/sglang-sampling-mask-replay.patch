+        top_ps = torch.repeat_interleave(sampling_info.top_ps, max_accept).index_select(
+            0, flat_rows
+        )
+        min_ps = torch.repeat_interleave(sampling_info.min_ps, max_accept).index_select(
+            0, flat_rows
+        )
+        sorted_probs, sorted_ids = row_probs.sort(dim=-1, descending=True)
+        ranks = torch.arange(sorted_probs.shape[-1], device=device).view(1, -1)
+        keep = ranks < top_ks[:, None]
+        if sampling_info.need_top_p_sampling:
+            keep &= (sorted_probs.cumsum(dim=-1) - sorted_probs) <= top_ps[:, None]
