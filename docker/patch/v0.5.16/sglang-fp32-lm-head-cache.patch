+"""Inference-only FP32 LM head cache, shared through the LM head module.
+
+Create during eager warmup, then refresh in place after online weight loads:
+CUDA graphs retain the cache address, not the Python attribute lookup.
+"""
+
+import torch
+
+
+@torch.no_grad()
+def get_fp32_lm_head_weight(lm_head):
+    weight = lm_head.weight
+    cache = getattr(lm_head, "_fp32_lm_head_weight", None)
+    if cache is None:
+        if weight.is_cuda and torch.cuda.is_current_stream_capturing():
+            raise RuntimeError("Warm up the FP32 LM head cache before CUDA graph capture")
+        # Warmup can run under inference_mode, but online updates may not.
+        with torch.inference_mode(False):
+            cache = weight.detach().to(dtype=torch.float32, copy=True)
+        lm_head.register_buffer("_fp32_lm_head_weight", cache, persistent=False)
+    if (
+        cache.shape != weight.shape
+        or cache.device != weight.device
+        or cache.dtype != torch.float32
+    ):
+        raise RuntimeError("FP32 LM head cache layout changed; restart the engine")
+    return cache
+
+
+@torch.no_grad()
+def refresh_fp32_lm_head_cache(model):
+    # Tensor._version does not cover .data writes, and graph replay skips Python.
+    # Explicitly refresh after every supported online weight-loading operation.
+    for module in model.modules():
+        if getattr(module, "_fp32_lm_head_weight", None) is not None:
+            get_fp32_lm_head_weight(module).copy_(module.weight)
