+def _gather_bf16_k_cache_paged(
+    k_cache_bf16: torch.Tensor,
+    page_table_1_flattened: torch.Tensor,
+    page_size: int,
+    out: Optional[torch.Tensor] = None,
+) -> torch.Tensor:
+    """bf16 counterpart of :func:`dequantize_k_cache_paged`. The bf16 KV pool
+    stores 512 contiguous bf16 elems/token (nope 448 + rope 64) with no scales,
