+    output_ptr,
+    buf_ptr,
+    page_table_ptr,
+    output_stride_0,
+    NUMEL_PER_PAGE: tl.constexpr,
+    PAGE_SIZE: tl.constexpr,
+    LATENT: tl.constexpr,
+    BLOCK: tl.constexpr,
+):
+    token_id = tl.program_id(0)
