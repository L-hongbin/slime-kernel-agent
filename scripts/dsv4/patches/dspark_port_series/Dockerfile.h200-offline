# H200 evaluation runtime for sites where the node cannot resolve PyPI.
#
# The build context must contain csl_v4_h200_eval_offline_deps.tar.gz. It is a
# root-relative tarball of the distributions missing from the upstream image,
# exported from the GPU-validated dspark-r3 Python 3.12 environment. The
# expected tarball checksum is checked by the launch/preflight workflow.
ARG DSPARK_BASE_IMAGE=v4.gh-proxy.org/docker/lmsysorg/sglang:dev-dspark
FROM ${DSPARK_BASE_IMAGE}

COPY 00*.patch /opt/dspark_port_series/
RUN cd /sgl-workspace/sglang \
    && test "$(git rev-parse HEAD)" = "692c5f7d532f129424b57961c262bbd253b411dc" \
    && for p in /opt/dspark_port_series/00*.patch; do \
         git apply --check "$p" && git apply "$p" || exit 1; \
       done \
    && test "$(git diff --binary | sha256sum | cut -d' ' -f1)" = \
       "d6261fe413b157ba4f06073a35cdce85e834cc8e5bd4efdb787345e1d091f2be" \
    && grep -q 'self.lora_enabled' python/sglang/srt/model_executor/model_runner.py \
    && python -c 'import sglang.srt.server_args'

ADD csl_v4_h200_eval_offline_deps.tar.gz /
RUN python -c 'import pylatexenc, ray, wandb; assert ray.__version__ == "2.55.1"' \
    && (python -m pip check >/tmp/pip-check.txt 2>&1; \
        rc=$?; cat /tmp/pip-check.txt; test "$rc" -eq 1; \
        test "$(wc -l </tmp/pip-check.txt)" -eq 2; \
        grep -Fx 'nixl 1.3.0 requires nixl-cu12, which is not installed.' /tmp/pip-check.txt; \
        grep -Fx 'moviepy 2.2.1 has requirement pillow<12.0,>=9.2.0, but you have pillow 12.3.0.' /tmp/pip-check.txt)
