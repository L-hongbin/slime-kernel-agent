 python/sglang/srt/model_executor/model_runner.py     | 12 +++++++++++-
 python/sglang/srt/speculative/dflash_worker_v2.py    |  2 ++
 .../srt/speculative/dspark_components/dspark_info.py |  6 ++++++
 .../dspark_components/dspark_target_verify.py        |  4 ++++
 .../dspark_components/dspark_worker_v2.py            |  2 ++
 5 files changed, 25 insertions(+), 1 deletion(-)

diff --git a/python/sglang/srt/model_executor/model_runner.py b/python/sglang/srt/model_executor/model_runner.py
index 2a55d67..cb1bbc8 100644
--- a/python/sglang/srt/model_executor/model_runner.py
+++ b/python/sglang/srt/model_executor/model_runner.py
@@ -3026,10 +3026,20 @@ class ModelRunner(ModelRunnerKVCacheMixin):
             not self.is_draft_worker
             and (experts_capturer := get_global_experts_capturer()) is not None
         ):
+            # Graph-replay row pitch: the buffer lays out per-dp-rank blocks of
+            # bs * num_tokens_per_bs TOKEN-ROWS (num_tokens_per_bs = draft width
+            # W under spec target-verify, 1 for plain decode). runner.bs alone
+            # is the REQUEST batch — using it as the pitch made every dp rank
+            # except 0 slice unwritten buffer under DSPARK (zero routing rows;
+            # upstream's own "FIXME: spec not accounted for").
+            _runner = self.decode_cuda_graph_runner
+            _graph_rows = None
+            if _runner is not None and getattr(_runner, "bs", None) is not None:
+                _graph_rows = _runner.bs * getattr(_runner, "num_tokens_per_bs", 1)
             output.routed_experts_output = experts_capturer.on_forward_end(
                 forward_batch=forward_batch,
                 can_run_graph=output.can_run_graph,
-                cuda_graph_batch=getattr(self.decode_cuda_graph_runner, "bs", None),
+                cuda_graph_batch=_graph_rows,
                 no_copy_to_cpu=no_copy_to_cpu,
             )
 
