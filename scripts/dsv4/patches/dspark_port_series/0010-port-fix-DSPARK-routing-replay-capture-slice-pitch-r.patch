 class TargetVerifyResult(msgspec.Struct, frozen=True):
     logits_output: object
     can_run_cuda_graph: bool
+    # Deferred state-capturer outputs from the inner target forward. DSpark
+    # rebuilds GenerationBatchResult after verify; without carrying these the
+    # routed-experts / indexer captures are silently dropped for every verify
+    # step (trainer routing replay then reads all-zero rows).
+    routed_experts_output: object = None
+    indexer_topk_output: object = None
 
 
 class DraftBlockResult(msgspec.Struct, frozen=True):
