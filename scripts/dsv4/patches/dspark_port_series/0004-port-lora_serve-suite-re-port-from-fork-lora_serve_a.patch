+    # Names the wrapper registers on itself during __init__ (weight/bias are
+    # Parameters) and the proxy target itself must NEVER be proxied: nn.Module's
+    # register_parameter/register_buffer use hasattr() as a collision guard, so a
+    # proxy would make `self.weight = base_layer.weight` raise
+    # KeyError("attribute 'weight' already exists") before the assignment lands.
+    _NO_PROXY_ATTRS = frozenset({"weight", "bias", "base_layer"})
+
+    def __getattr__(self, name: str):
+        # Transparent proxy: fall back to the wrapped base layer for attributes
+        # the LoRA wrapper does not define (e.g. reduce_results, tp_size,
+        # output_size), so model code / fused kernels that read base-layer
+        # attributes off the (now possibly wrapped) module keep working. Only
+        # reached when nn.Module's own lookup (params/buffers/submodules) misses.
+        try:
+            return super().__getattr__(name)
+        except AttributeError:
+            if name in BaseLayerWithLoRA._NO_PROXY_ATTRS:
+                raise
+            # Look up base_layer without re-entering __getattr__ (avoid recursion
+            # and the register_parameter hasattr guard during __init__).
+            base_layer = self.__dict__.get("_modules", {}).get("base_layer")
+            if base_layer is None:
+                raise
+            return getattr(base_layer, name)
+
     def forward(self, x: torch.Tensor):
         return self.base_layer.forward(x)
 
