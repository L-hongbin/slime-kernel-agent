+    @staticmethod
+    def _debug_validate_sgemm(tag, x, weights, info, base_output=None, output_offset=None):
+        """Fail-fast invariant check before launching the triton LoRA kernels
+        (env SGLANG_LORA_CHECK_BATCH=1). An x/batch_info row mismatch or a bad
+        weight index makes the kernels chase wild pointers — the resulting
+        illegal access surfaces later (DeepEP / graph replay) with no producer
+        frame. Syncs the stream; debug runs only."""
+        import os
+
+        if os.environ.get("SGLANG_LORA_CHECK_BATCH", "0") != "1":
+            return
+        problems = []
+        if info is None:
+            problems.append("batch_info is None")
+        else:
+            total = int(info.seg_indptr[-1].item())
+            if total != x.size(0):
+                problems.append(f"x rows {x.size(0)} != seg total {total}")
+            wi = info.weight_indices[: info.num_segments]
+            wi_max = int(wi.max().item()) if wi.numel() else -1
+            wi_min = int(wi.min().item()) if wi.numel() else 0
+            if wi_max >= weights.size(0) or wi_min < 0:
+                problems.append(
+                    f"weight_indices out of range [{wi_min},{wi_max}] vs num_lora {weights.size(0)}"
+                )
+            if info.max_len is not None and info.seg_lens is not None:
+                sl = info.seg_lens[: info.num_segments]
+                if sl.numel() and int(sl.max().item()) > info.max_len:
+                    problems.append(
+                        f"seg_lens max {int(sl.max().item())} > max_len {info.max_len}"
+                    )
+        if output_offset is not None and base_output is not None:
+            off_last = int(output_offset[-1].item())
+            if off_last > base_output.size(1):
+                problems.append(
+                    f"output_offset[-1] {off_last} > base_output cols {base_output.size(1)}"
+                )
+        if problems:
+            detail = ""
+            if info is not None:
+                detail = (
+                    f" bs={info.bs} num_segments={info.num_segments}"
+                    f" use_cuda_graph={info.use_cuda_graph} max_len={info.max_len}"
+                    f" seg_indptr={info.seg_indptr[:min(info.num_segments + 1, 32)].tolist()}"
+                    f" weight_indices={info.weight_indices[:min(info.num_segments, 32)].tolist()}"
+                    f" lora_ranks={info.lora_ranks.tolist()}"
+                    f" scalings={info.scalings.tolist()}"
+                )
+            raise RuntimeError(
+                f"LoRA sgemm invariant violated at {tag}: {'; '.join(problems)}."
+                f" x={tuple(x.shape)}/{x.dtype} weights={tuple(weights.shape)}"
+                + (f" base_output={tuple(base_output.shape)}" if base_output is not None else "")
+                + detail
+            )
+
