+def _merge_partials_and_sink_fp32(
+    out1: torch.Tensor,
+    lse1: torch.Tensor,
+    out2: Optional[torch.Tensor],
+    lse2: Optional[torch.Tensor],
+    attn_sink: Optional[torch.Tensor],
+) -> Tuple[torch.Tensor, torch.Tensor]:
+    """Fused fp32 LSE merge + attention-sink fold with ONE final bf16 store.
+
+    DS-V4 fixed path: `out1`/`out2` are fp32 partials fresh
+    from the decode kernel's fp32 accumulator (never materialized in bf16), so
+    unlike `_merge_partial_attn` + `_apply_attn_sink` there is no bf16
+    round-trip for (a) either partial, (b) the merged pre-sink output. The
+    arithmetic below mirrors those two functions exactly; only the intermediate
+    roundings are removed — matching the trainer A1 kernel, whose single fp32
+    online-softmax state folds the sink before its one bf16 store.
+
+    out1/out2: [B, 1, H, D] fp32,  lse1/lse2: [B, 1, H] fp32,  attn_sink: [H] f32
+    """
+    if out2 is not None:
+        max_lse = torch.maximum(lse1, lse2)
+        w1 = torch.where(
+            lse1 > -1e20, torch.exp(lse1 - max_lse), torch.zeros_like(lse1)
+        )
+        w2 = torch.where(
+            lse2 > -1e20, torch.exp(lse2 - max_lse), torch.zeros_like(lse2)
+        )
+        total = (w1 + w2).clamp(min=1e-20)
+        merged = (
+            w1.unsqueeze(-1) * out1.float() + w2.unsqueeze(-1) * out2.float()
+        ) / total.unsqueeze(-1)
+        lse = max_lse + torch.log(total)
+    else:
+        merged = out1.float()
+        lse = lse1
+    if attn_sink is not None:
+        sink_lse = attn_sink.view(1, 1, -1).expand_as(lse)
+        combined_lse = torch.logaddexp(lse, sink_lse)
+        w = torch.where(
+            lse > -1e20,
+            torch.exp(lse - combined_lse),
+            torch.zeros_like(lse),
+        )
+        merged = merged * w.unsqueeze(-1)
+        lse = combined_lse
+    return merged.to(torch.bfloat16), lse
+
